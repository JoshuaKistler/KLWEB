---
interface Props {
  variant?: 'default' | 'inverted';
}

const { variant = 'default' } = Astro.props;
---

<span class:list={['logo', `logo--${variant}`]}>
  <span class="logo-mark" aria-hidden="true">KL</span>
  <span class="logo-word">KLWEB</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-ink);
  }

  .logo-mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.55rem;
    background: var(--color-primary);
    color: var(--color-bg);
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .logo-mark::after {
    content: '';
    position: absolute;
    right: 0.3rem;
    bottom: 0.3rem;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 1px;
    background: var(--color-copper-light);
  }

  .logo-word {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.14em;
  }

  .logo--inverted {
    color: var(--color-bg);
  }

  .logo--inverted .logo-mark {
    background: var(--color-bg);
    color: var(--color-primary);
  }
</style>
