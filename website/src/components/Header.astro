---
import Logo from './Logo.astro';
import { mainNav, contactLink, isCurrent, withBase } from '../data/navigation';

const { pathname } = Astro.url;
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href={withBase('/')} aria-label="KLWEB – zur Startseite" aria-current={isCurrent(pathname, '/') ? 'page' : undefined}>
      <Logo />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="nav-toggle-icon" aria-hidden="true"></span>
      <span class="nav-toggle-label">Menü</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Hauptnavigation" data-nav>
      <ul class="nav-list" role="list">
        {
          mainNav.map((link) => (
            <li>
              <a class="nav-link" href={withBase(link.href)} aria-current={isCurrent(pathname, link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="nav-cta">
          <a
            class="btn btn--primary"
            href={withBase(contactLink.href)}
            aria-current={isCurrent(pathname, contactLink.href) ? 'page' : undefined}
          >
            {contactLink.label}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (header && toggle && nav) {
    const desktop = window.matchMedia('(min-width: 56em)');
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean, returnFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
      document.body.classList.toggle('nav-open', open);
      if (!open && returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    nav.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) setOpen(false, true);
    });

    header.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (isOpen() && next && !header.contains(next)) setOpen(false);
    });

    desktop.addEventListener('change', (event) => {
      if (event.matches && isOpen()) setOpen(false);
    });

    const updateScrolled = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    updateScrolled();
    window.addEventListener('scroll', updateScrolled, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--duration-base) ease,
      box-shadow var(--duration-base) ease;
  }

  .site-header[data-scrolled] {
    border-bottom-color: var(--color-line);
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
  }

  .brand {
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--color-ink);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.2rem;
    height: 1.5px;
    background: var(--color-copper);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav-link[aria-current='page'] {
    color: var(--color-primary);
  }

  /* Ohne JavaScript bleibt die Navigation sichtbar und der Button verborgen */
  .nav-toggle {
    display: none;
  }

  @media (max-width: 55.99em) {
    :global(.js) .nav-toggle {
      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      min-height: 2.75rem;
      padding: 0.5rem 1rem;
      border: 1.5px solid var(--color-line);
      border-radius: 999px;
      background: var(--color-surface);
      font-size: var(--step--1);
      font-weight: 600;
      cursor: pointer;
      transition: border-color var(--duration-fast) ease;
    }

    :global(.js) .nav-toggle:hover {
      border-color: var(--color-primary);
    }

    .nav-toggle-icon {
      position: relative;
      width: 1.1rem;
      height: 0.7rem;
    }

    .nav-toggle-icon::before,
    .nav-toggle-icon::after {
      content: '';
      position: absolute;
      left: 0;
      width: 100%;
      height: 1.5px;
      border-radius: 1px;
      background: currentColor;
      transition:
        transform var(--duration-base) var(--ease-out),
        top var(--duration-base) var(--ease-out);
    }

    .nav-toggle-icon::before {
      top: 0;
    }

    .nav-toggle-icon::after {
      top: calc(100% - 1.5px);
    }

    .nav-toggle[aria-expanded='true'] .nav-toggle-icon::before {
      top: calc(50% - 0.75px);
      transform: rotate(45deg);
    }

    .nav-toggle[aria-expanded='true'] .nav-toggle-icon::after {
      top: calc(50% - 0.75px);
      transform: rotate(-45deg);
    }

    .site-nav {
      width: 100%;
      padding-bottom: var(--space-4);
    }

    :global(.js) .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: auto;
      height: calc(100vh - var(--header-h));
      height: calc(100dvh - var(--header-h));
      overflow-y: auto;
      padding: var(--space-6) var(--gutter) var(--space-8);
      background: var(--color-bg);
      border-top: 1px solid var(--color-line);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.5rem);
      transition:
        opacity var(--duration-base) ease,
        transform var(--duration-base) var(--ease-out),
        visibility 0s linear var(--duration-base);
    }

    :global(.js) .site-nav[data-open] {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    :global(.js) .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    :global(.js) .nav-list li:not(.nav-cta) {
      border-bottom: 1px solid var(--color-line);
    }

    :global(.js) .nav-link {
      display: block;
      padding-block: var(--space-4);
      font-family: var(--font-serif);
      font-size: var(--step-2);
      font-weight: 600;
    }

    :global(.js) .nav-link::after {
      display: none;
    }

    :global(.js) .nav-link[aria-current='page'] {
      color: var(--color-copper);
    }

    :global(.js) .nav-cta {
      margin-top: var(--space-6);
    }

    :global(.js) .nav-cta .btn {
      width: 100%;
      min-height: 3.25rem;
      font-size: var(--step-0);
    }
  }

  :global(body.nav-open) {
    overflow: hidden;
  }

  @media (min-width: 56em) {
    .header-inner {
      flex-wrap: nowrap;
    }

    .nav-list {
      gap: var(--space-6);
    }

    .nav-cta {
      margin-left: var(--space-2);
    }
  }
</style>
