---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../data/navigation';

const phases = [
  {
    id: 'analyse',
    title: 'Analyse und Gespräch',
    intro:
      'Im ersten Gespräch lernen wir deinen Betrieb kennen. Wir klären deine Ziele, deine Zielgruppe und welche Inhalte bereits vorhanden sind.',
    contribution:
      'Erzähl uns von deinem Betrieb, deiner Kundschaft und deinen Wünschen. Zeig uns, was schon da ist – zum Beispiel Texte, Fotos oder dein Logo.',
    expectation:
      'Wir hören zu, stellen Fragen und halten gemeinsam fest, was deine Website leisten soll und welche Seiten sie braucht.',
  },
  {
    id: 'designprototyp',
    title: 'Designprototyp',
    intro:
      'Bevor wir mit der Umsetzung beginnen, zeigen wir dir einen Entwurf deiner Website. So stimmen wir Aufbau und Gestaltung gemeinsam ab.',
    contribution:
      'Schau dir den Prototyp in Ruhe an und sag uns offen, was dir gefällt und was du dir anders wünschst.',
    expectation:
      'Ein Entwurf, der zeigt, wie deine Website aufgebaut ist und wie sie aussehen wird. Deine Rückmeldungen besprechen wir und passen den Entwurf im vereinbarten Rahmen an.',
  },
  {
    id: 'entwicklung',
    title: 'Entwicklung',
    intro:
      'Wir setzen das abgestimmte Design als responsive Website um. Das heisst: Sie passt sich an Handy, Tablet und Computer an.',
    contribution:
      'Stell uns die finalen Inhalte zur Verfügung, etwa Texte, Bilder und Kontaktangaben. Wenn Fragen auftauchen, melden wir uns bei dir.',
    expectation:
      'Eine schlanke Website auf Grundlage des vereinbarten Designs – gut lesbar und einfach zu bedienen.',
  },
  {
    id: 'testing-launch',
    title: 'Testing und Launch',
    intro:
      'Vor der Veröffentlichung prüfen wir die Darstellung, die Links und die zentralen Funktionen deiner Website. Danach schalten wir sie online.',
    contribution:
      'Schau dir die fertige Website an, prüfe deine Inhalte und gib uns dein Okay für die Veröffentlichung.',
    expectation:
      'Wir testen die Website auf verschiedenen Bildschirmgrössen und veröffentlichen sie, sobald du einverstanden bist.',
  },
  {
    id: 'betreuung',
    title: 'Betreuung',
    intro:
      'Auch nach dem Launch bist du nicht allein. Wir betreuen deine Website technisch – im Umfang, den wir vorher gemeinsam vereinbart haben.',
    contribution: 'Melde dich bei uns, wenn dir an deiner Website etwas auffällt.',
    expectation:
      'Technische Betreuung im vereinbarten Umfang. Was genau dazugehört, legen wir transparent mit dir fest, bevor das Projekt startet.',
  },
];
---

<BaseLayout
  title="Ablauf"
  description="So läuft ein Website-Projekt mit KLWEB ab: Analyse und Gespräch, Designprototyp, Entwicklung, Testing und Launch sowie technische Betreuung im vereinbarten Umfang."
>
  <section class="page-hero" aria-labelledby="page-title">
    <div class="container page-hero-content">
      <p class="eyebrow fade-up">Ablauf</p>
      <h1 id="page-title" class="fade-up" style="--delay: 1">
        In fünf Schritten <span class="page-hero-accent">zu deiner Website.</span>
      </h1>
      <p class="lead fade-up" style="--delay: 2">
        Ein klarer Ablauf, damit du jederzeit weisst, woran wir gerade arbeiten, was als Nächstes kommt und wo
        wir dich brauchen.
      </p>
      <div class="page-hero-actions fade-up" style="--delay: 3">
        <a class="btn btn--primary btn--large" href={withBase('/kontakt')}>
          Projekt anfragen <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--secondary btn--large" href={withBase('/leistungen')}>Zu den Leistungen</a>
      </div>
    </div>
  </section>

  <section class="section phases" aria-labelledby="phases-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Schritt für Schritt</p>
        <h2 id="phases-title">So entsteht deine Website</h2>
        <p class="section-intro">
          Bei jedem Schritt siehst du, was wir übernehmen und was du beitragen kannst. Wie lange ein Projekt
          dauert, hängt vom Umfang ab – einen realistischen Zeitplan besprechen wir gemeinsam.
        </p>
      </header>

      <nav class="overview" aria-label="Die fünf Schritte im Überblick">
        <ol class="overview-list" role="list">
          {
            phases.map((phase, index) => (
              <li>
                <a class="overview-link" href={`#${phase.id}`}>
                  <span class="overview-number" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="visually-hidden">Schritt {index + 1}: </span>
                  {phase.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <ol class="phase-list" role="list">
        {
          phases.map((phase, index) => (
            <li class="phase" id={phase.id}>
              <article class="phase-card" aria-labelledby={`${phase.id}-title`}>
                <header class="phase-head">
                  <span class="phase-number" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h3 id={`${phase.id}-title`} class="phase-title">
                    <span class="visually-hidden">Schritt {index + 1}: </span>
                    {phase.title}
                  </h3>
                </header>
                <p class="phase-intro">{phase.intro}</p>
                <div class="phase-roles">
                  <div class="role role--you">
                    <h4 class="role-title">Was du beiträgst</h4>
                    <p>{phase.contribution}</p>
                  </div>
                  <div class="role role--us">
                    <h4 class="role-title">Was du erwarten kannst</h4>
                    <p>{phase.expectation}</p>
                  </div>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section notes" aria-labelledby="notes-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Gut zu wissen</p>
        <h2 id="notes-title">Offen und verständlich</h2>
      </header>

      <ul class="card-grid card-grid--3" role="list">
        <li class="card">
          <h3>Gemeinsam entscheiden</h3>
          <p>
            Du siehst einen Entwurf, bevor wir die Website umsetzen, und gibst sie vor dem Launch frei. Wichtige
            Entscheidungen treffen wir mit dir.
          </p>
        </li>
        <li class="card">
          <h3>Klarer Umfang</h3>
          <p>
            Was deine Website umfassen soll und was zur Betreuung gehört, halten wir vor Projektstart gemeinsam fest.
          </p>
          <p>
            <a class="text-link" href={withBase('/leistungen')}>Mehr zu den Leistungen <span aria-hidden="true">→</span></a>
          </p>
        </li>
        <li class="card">
          <h3>Ein Beispiel ansehen</h3>
          <p>Du möchtest sehen, wie eine fertige Website von uns aussieht? Schau dir unser Referenzprojekt an.</p>
          <p>
            <a class="text-link" href={withBase('/projekte')}>Zu den Projekten <span aria-hidden="true">→</span></a>
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta-box">
        <h2 id="cta-title">Bereit für den ersten Schritt?</h2>
        <p>
          Erzähl uns von deinem Betrieb und deinen Vorstellungen. Im ersten Gespräch klären wir gemeinsam, was deine
          Website leisten soll.
        </p>
        <a class="btn btn--light btn--large" href={withBase('/kontakt')}>
          Projekt anfragen <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Seitenkopf (entspricht leistungen.astro) */
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-6) var(--space-8);
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: -30% -15% auto auto;
    width: min(36rem, 85vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle at 40% 40%,
      color-mix(in srgb, var(--color-copper-light) 20%, transparent),
      color-mix(in srgb, var(--color-primary) 7%, transparent) 55%,
      transparent 70%
    );
    pointer-events: none;
  }

  .page-hero-content {
    position: relative;
    display: grid;
    gap: var(--space-4);
  }

  .page-hero h1 {
    max-width: 18ch;
  }

  .page-hero-accent {
    display: block;
    color: var(--color-primary);
  }

  .page-hero-actions {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* Buttons (entsprechen der Startseite) */
  .btn--large {
    min-height: 3.25rem;
    padding-inline: 1.6rem;
    font-size: var(--step-0);
  }

  .btn--light {
    --btn-bg: var(--color-bg);
    --btn-fg: var(--color-primary-strong);
    --btn-border: var(--color-bg);
  }

  .btn--light:hover {
    --btn-bg: #fff;
    --btn-border: #fff;
    box-shadow: var(--shadow-md);
  }

  /* Abschnittsköpfe und Links */
  .section-head {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
    margin-bottom: var(--space-7);
  }

  .section-intro {
    color: var(--color-ink-muted);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    font-weight: 600;
  }

  /* Schritte */
  .phases {
    background: var(--color-surface-alt);
  }

  .overview {
    margin-bottom: var(--space-7);
  }

  .overview-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .overview-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .overview-link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-strong);
  }

  .overview-number {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-family: var(--font-serif);
  }

  .phase-list {
    --phase-gap: var(--space-6);
    --phase-pad: var(--space-5);
    --phase-number: 3rem;

    display: grid;
    gap: var(--phase-gap);
    padding: 0;
    list-style: none;
  }

  .phase {
    position: relative;
  }

  /* Verbindungslinie zwischen den Schritten, mittig unter der Nummer */
  .phase:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 100%;
    left: calc(var(--phase-pad) + var(--phase-number) / 2 - 1px);
    width: 2px;
    height: var(--phase-gap);
    background: var(--color-line);
  }

  .phase-card {
    display: grid;
    gap: var(--space-4);
    padding: var(--phase-pad);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition: border-color var(--duration-base) ease;
  }

  /* Hervorhebung nach einem Sprung aus der Übersicht */
  .phase:target .phase-card {
    border-color: var(--color-primary);
  }

  .phase-head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .phase-number {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--phase-number);
    height: var(--phase-number);
    border: 1.5px solid var(--color-primary);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-primary);
    font-family: var(--font-serif);
    font-size: var(--step-0);
    font-weight: 600;
  }

  .phase-title {
    font-size: var(--step-2);
  }

  .phase-intro {
    color: var(--color-ink-muted);
  }

  .phase-roles {
    display: grid;
    gap: var(--space-3);
  }

  .role {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    border-left: 3px solid var(--color-primary);
  }

  .role--us {
    border-left-color: var(--color-copper);
  }

  .role-title {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-primary-strong);
  }

  .role p {
    line-height: 1.55;
  }

  /* Gut zu wissen */
  .card-grid {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .card {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .card h3 {
    font-size: var(--step-1);
  }

  .card p {
    color: var(--color-ink-muted);
  }

  /* Abschluss-CTA */
  .cta {
    padding-bottom: var(--space-9);
  }

  .cta-box {
    --color-focus: #f3c9a8;

    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-primary);
    color: #e6eeec;
  }

  .cta-box h2 {
    color: #fff;
    max-width: 20ch;
  }

  .cta-box .btn {
    margin-top: var(--space-2);
  }

  /* Mobile: kompaktere Karten, Buttons über die volle Breite */
  @media (max-width: 29.99em) {
    .page-hero .lead {
      font-size: var(--step-0);
    }

    .phase-list {
      --phase-pad: var(--space-4);
      --phase-number: 2.5rem;
    }

    .phase-head {
      gap: var(--space-3);
    }

    .phase-title {
      font-size: var(--step-1);
    }

    .card {
      padding: var(--space-5);
    }

    .cta-box .btn {
      width: 100%;
    }
  }

  @media (min-width: 30em) {
    .page-hero-actions {
      display: flex;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 40em) {
    .phase-list {
      --phase-pad: var(--space-6);
    }

    .phase-roles {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }

    .card-grid--3 {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-box {
      padding: var(--space-8);
    }
  }

  @media (min-width: 56em) {
    .page-hero {
      padding-block: var(--space-8);
    }

    .page-hero-content {
      gap: var(--space-5);
    }

    /* Inhalt neben der Nummer ausrichten */
    .phase-card {
      grid-template-columns: var(--phase-number) 1fr;
      column-gap: var(--space-5);
    }

    .phase-head {
      display: contents;
    }

    .phase-number {
      grid-row: span 3;
      align-self: start;
    }

    .phase-title {
      align-self: center;
    }

    .phase-intro,
    .phase-roles {
      grid-column: 2;
    }

    .card-grid--3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
